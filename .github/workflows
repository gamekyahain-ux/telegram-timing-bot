name: Telegram Lock Unlock

on:
  schedule:
    - cron: "30 7 * * *"
    - cron: "20 9 * * *"
    - cron: "30 9 * * *"
    - cron: "0 11 * * *"
    - cron: "30 11 * * *"
    - cron: "20 12 * * *"
    - cron: "30 12 * * *"
    - cron: "20 16 * * *"
    - cron: "30 16 * * *"
    - cron: "30 21 * * *"
  workflow_dispatch:

jobs:
  lock-unlock:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run lock unlock
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
        run: python bot.py
